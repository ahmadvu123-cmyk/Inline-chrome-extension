{
    "manifest_version": 3,
    "name": "Gmail Sync Extension",
    "version": "1.0.0",
    "description": "Connect Gmail and sync emails",
    "action": {
        "default_title": "Gmail Sync",
        "default_popup": "src/popup/popup.html"
    },
    "background": {
        "service_worker": "background/service-worker.js",
        "type": "module"
    },
    "permissions": [
        "identity",
        "storage"
    ],
    "host_permissions": [
        "https://gmail.googleapis.com/*",
        "https://*.supabase.co/*"
    ],
    "oauth2": {
        "client_id": "227433695377-patmrn79fosfhbicvi0ef5468b02rivp.apps.googleusercontent.com",
        "scopes": [
            "https://www.googleapis.com/auth/gmail.readonly"
        ]
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}